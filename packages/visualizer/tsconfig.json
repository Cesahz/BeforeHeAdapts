{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // DOM entra porque `export/browser.ts` graba con canvas y MediaRecorder.
    // El `lib` no distingue archivos, así que a nivel de tipos habilita el DOM
    // en todo el paquete: la frontera real la defiende `purity.test.ts`, que
    // falla si cualquier módulo fuera de `export/browser.ts` toca el entorno.
    "lib": ["ES2022", "DOM"],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": []
  },
  // El núcleo entra por project reference: se tipa contra sus declaraciones
  // publicadas, no recompilando su código dentro de este programa. Vitest, en
  // cambio, resuelve `@beforeheadapts/core` por fuente (ver `vitest.config.ts`)
  // para no exigir un build previo al correr los tests.
  "references": [{ "path": "../core" }],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
