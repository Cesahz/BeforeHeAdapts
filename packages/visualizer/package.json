{
  "name": "@beforeheadapts/visualizer",
  "version": "0.2.0",
  "description": "Replay del log de eventos a frames renderizables. Derivación pura; el render es un adaptador.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/export/browser.d.ts",
      "import": "./dist/export/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "demo": "tsc --build && node scripts/demo.ts",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@beforeheadapts/core": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "^3.23.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
