# ============================================
# BeforeHeAdapts — .gitignore
# ============================================

# --- Dependencias ---
node_modules/
.pnpm-store/
.pnpm-debug.log*

# --- Builds y artefactos ---
dist/
build/
out/
*.tsbuildinfo
coverage/
.vite/
.turbo/

# --- Entorno y secretos ---
.env
.env.*
!.env.example

# --- Claude Code: método de trabajo con IA (no publicar) ---
# Se oculta el "cómo", no el "qué": el conocimiento del proyecto vive en docs/.
.claude/
CLAUDE.md

# --- Docs privados: notas personales del autor ---
docs/privado/

# --- Renders del visualizador  ---
packages/visualizer/renders/

# --- Sistema operativo / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/*
!.vscode/extensions.json